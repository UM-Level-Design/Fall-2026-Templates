/* ====================================================================== */
/* GROUP: TABBAR / TABS */
/* ====================================================================== */

.TabBar{
    width: 100%;
    display: flex;
    flex-direction: row;
}

.TabHeader{
    
    -unity-font-style: bold;
    background-color: rgba(0,0,0,0.25); /* slightly lighter tabs */
    color: #fff;
    align-self: center;
}
.TabHeader *{
   
    align-self: center;
}

.TabHeaderSelected{
    border-bottom-color: rgba(0,0,0,0);
    background-color: transparent; /* keep selected appearance from USS elsewhere or inherit */
}

.TabContent{
    padding-top: 6px;
}

