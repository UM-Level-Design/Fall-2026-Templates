:root{
    --header: rgba(0,0,0,0.15);
    --border: rgba(28,28,28,1);
    --main-text: rgba(1,1,1,1);
    --sec-text: rgba(1,1,1,1);
}
.unity-theme-light :root {
    --border: rgba(161,161,161,1);
}

/* ====================================================================== */
/* GROUP: MONOSCRIPT / GENERAL VARIABLES */
/* ====================================================================== */

.Monoscript{
    padding: 0px !important;
    padding-top: 0px !important;
    padding-bottom: 0px ;
    border-width: 1px;
    border-color: var(--border);
    margin: 0px;
}

/* ====================================================================== */
/* GROUP: BOXS / GROUPS / FOLDOUT / REORDERABLE / DRAG HANDLE (GROUPS)
   These selectors affect BoxHeaders, BoxContent, Foldouts, Reorderable lists
   and other grouped UI elements used by group-like attributes.
   (Moved into GROUPS for clarity.)
*/
/* ====================================================================== */

.BoxHeader{
    padding: 0px;
    min-height: 24px;
    max-height: 24px;
    display: flex;
    flex-direction: row;
    margin: 0;
    flex-grow: 1;
    color: #ffffff;
    -unity-font-style: bold;
    border-left-width: 1px; border-right-width: 1px; border-top-width: 1px; border-bottom-width: 1px;
    border-left-color: var(--border); border-right-color: var(--border); border-top-color: var(--border);  border-bottom-color: var(--border);
    background-color: var(--header); 
    
    border-top-left-radius: 3px;
    border-top-right-radius: 3px;
}
.BoxHeaderRounded{
        border-bottom-left-radius: 3px;
    border-bottom-right-radius: 3px;
    margin-bottom: 2px;
}


.BoxHeaderIcon{
        width: 20px;
    height: 20px;
    margin: 0px;
    margin-left: 2px;
    margin-top: 0.3px;
    align-self: center; 
    border-color: var(--border); 
}
.BoxFoldoutIcon{ 
        width: 25px;
    height: 14px;
    padding: 5px;
    align-self: center; 
    border-color: var(--border); 
    border-left-width: 0px;
    font-size:  9px;
    opacity: 1;
}
.FoldoutCountLabel{
    margin-right: 4px;
    font-size:  10px;
    opacity: 0.6;
}
.FoldoutAddButton{
    height: 20px;
    width: 26px;
    padding: 0px;
    margin: 0px;
    background-color: transparent;
    border-width: 0px;
    border-left-width: 1px;
     border-color: var(--border);
     align-items: center;
}
.ReorderableLabel{
    height: 22px;
    padding: 0px;
    padding-left: 5px;
    margin: 0px;
    border-width: 0px;
    border-left-width: 1px;
    -unity-text-align: middle-left;
}

.ReorderDeleteButton{
    height: 20px;
    width: 26px;
    padding: 0px;
    margin: 0px;
    background-color: transparent;
    border-width: 0px;
    border-left-width: 1px;
     border-color: var(--border);
     opacity:0.6;
     align-items: center;
}
.reorderableContainer{
    border-width: 1px;
    border-top-width: 0px;
    border-bottom-width: 0px;
     border-color: var(--border);
     padding: 0px;
     
        border-bottom-left-radius: 3px;
    border-bottom-right-radius: 3px;
    margin-bottom: 4px;
}
.ReorderableRow{
        border-bottom-width: 1px;
     border-color: var(--border);
     min-height: 26px;
     margin: 0px;
}

.ReorderablePropertyField, .ReorderablePropertyField .unity-base-field{
    margin: 0px;
    padding: 0px;
    padding-left: 2px;
    padding-right: 2px;
    
}.ReorderablePropertyField{
    padding-top: 3px;
    padding-bottom: 3px;
    
}

.DragHandle{
    width: 25px;
    min-height: 25px;
    padding: 3px;
    border-width: 0px;
    border-right-width: 1px;
     border-color: var(--border);
}

.DragHandleImage{
    height: 20px;
    width: 20px;
    opacity:0.8;
}

.BoxContent{
    padding: 4px 4px 4px 4px;
    margin: 0 0 2px 0;
    border-bottom-left-radius: 3px;
    border-bottom-right-radius: 3px;
    border-left-width: 1px; border-right-width: 1px; border-top-width: 0px; border-bottom-width: 1px;
    border-left-color: var(--border); border-right-color: var(--border); border-bottom-color: var(--border);
    background-color: transparent;
}

